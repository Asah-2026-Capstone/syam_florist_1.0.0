# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# ===== Umum =====
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
TZ=Asia/Jakarta

# ===== Database (Neon PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ===== Autentikasi Admin =====
# Minimal 32 karakter acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@syamflorist.id
ADMIN_SEED_PASSWORD=ganti-dengan-password-kuat
ADMIN_SEED_NAME=Pemilik Syam Florist

# ===== Pembayaran Transfer Manual (nilai awal tabel Setting) =====
PAYMENT_BANK_NAME=Bank BCA
PAYMENT_ACCOUNT_NUMBER=1234567890
PAYMENT_ACCOUNT_NAME=Syam Florist
PAYMENT_DP_PERCENT=50
